                file_df = file_df.withColumn("batch_id", lit(batch_id))

                if dqm_master.criticality == "C":

                    file_df.write.format("delta").mode("append").partitionBy(
                        self.staging_partition_columns
                    ).save(self.staging_location)

                    publish_path = self.publish_location
                    file_df.write.format("delta").mode("append").partitionBy(
                        self.publish_partition_columns
                    ).save(publish_path)

                elif dqm_master.criticality == "NC":

                    original_df.write.format("delta").mode("append").partitionBy(
                        self.staging_partition_columns
                    ).save(self.staging_location)

                    publish_path = self.publish_location
                    original_df.write.format("delta").mode("append").partitionBy(
                        self.publish_partition_columns
                    ).save(publish_path)
        else:
            raise Exception(
                f"DQM is already processed for Dataset ID: {self.dataset_id}."
            )

    def __init__(
        self,
        spark: SparkSession,
        process_id,
        dataset_id,
        data_standardisation_location,
        dqm_location,
        staging_location,
        staging_partition_columns,
        publish_location,
        publish_partition_columns,
    ):
        self.spark: SparkSession = spark
        self.process_id = process_id
        self.dataset_id = dataset_id
        self.data_standardisation_location = data_standardisation_location
        self.dqm_location = dqm_location
        self.staging_location = staging_location
        self.staging_partition_columns = staging_partition_columns
        self.publish_location = publish_location
        self.publish_partition_columns = publish_partition_columns

        with OrchestrationProcess.OrchestrationProcess() as orch_process:

            dqm_unprocessed_files = orch_process.get_dqm_unprocessed_files(
                process_id=process_id,
                dataset_id=dataset_id,
            )

            self.dqm_unprocessed_files = dqm_unprocessed_files

            dqm_masters = orch_process.get_dqm_master_dtl(
                process_id=process_id, dataset_id=dataset_id
            )
            self.dqm_masters = dqm_masters

        if len(dqm_masters) != 0:
            self.start_dqm_check()
        else:

            if len(dqm_unprocessed_files) != 0:

                for data_standardisation_log in dqm_unprocessed_files:
                    start_time = datetime.now()
                    batch_id = data_standardisation_log.batch_id
                    file_df = (
                        spark.read.format("delta")
                        .load(data_standardisation_location)
                        .filter(col("batch_id") == batch_id)
                    )

                    file_df.write.format("delta").mode("append").partitionBy(
                        staging_partition_columns
                    ).save(staging_location)

                    publish_path = publish_location
                    file_df.write.format("delta").mode("append").partitionBy(
                        publish_partition_columns
                    ).save(publish_path)

                    with OrchestrationProcess.OrchestrationProcess() as orch_process:
                        orch_process.insert_log_dqm_dtl(
                            process_id=process_id,
                            dataset_id=dataset_id,
                            batch_id=batch_id,
                            source_file=data_standardisation_log.source_file,
                            status="SUCCEEDED",
                            dqm_start_time=start_time,
                            dqm_end_time=datetime.now(),
                        )
            else:
                with OrchestrationProcess.OrchestrationProcess() as orch_process:
                    orch_process.insert_log_dqm_dtl(
                        process_id=process_id,
                        dataset_id=dataset_id,
                        batch_id=None,
                        source_file=None,
                        status="FAILED",
                        dqm_start_time=start_time,
                        dqm_end_time=datetime.now(),
                        exception_details=f"DQM is already processed for Dataset ID: {dataset_id}.",
                    )
                raise Exception(
                    f"DQM is already processed for Dataset ID: {dataset_id}."
                )
