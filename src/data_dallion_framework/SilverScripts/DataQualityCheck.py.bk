from datetime import datetime
from pyspark.sql.functions import col, lit, length
from pyspark.sql import DataFrame
from pyspark.sql import SparkSession
from ast import literal_eval

from data_dallion_framework.Common import OrchestrationProcess, RegexDateFormats


class DataQualityCheck:
    def null_check_dqm(
        self,
        input_df: DataFrame,
        column_name: str,
        total_count: int,
        error_threshold: int,
        qc_filter: str,
        qc_id: int,
        dataset_id: int,
        failure_path: str,
    ) -> dict:

        if qc_filter:
            filter_cols = qc_filter.split(",")
            filter_cols = " AND ".join(filter_cols)
            null_check_dqm_ = input_df.filter(col(column_name).isNotNull()).filter(
                filter_cols
            )
        else:
            null_check_dqm_ = input_df.filter(col(column_name).isNotNull())

        failure_count = total_count - null_check_dqm_.count()

        if failure_count != 0:
            failed_records = input_df.subtract(null_check_dqm_)
            failed_records = (
                failed_records.withColumn("dqm_check_type", lit("NULL"))
                .withColumn("failed_column_name", lit(column_name))
                .withColumn("fail_value", col(column_name))
                .select(
                    "dqm_check_type", "failed_column_name", "fail_value", "batch_id"
                )
            )
            failed_records.write.format("delta").mode("append").partitionBy(
                "batch_id"
            ).save(failure_path)

        if total_count > 0:
            failure_percentage = (failure_count / total_count) * 100
        else:
            failure_percentage = 0

        if failure_percentage >= error_threshold:
            return {
                "df": None,
                "error_count": failure_count,
                "error_percentage": failure_percentage,
                "success": False,
            }
        else:
            return {
                "df": null_check_dqm_,
                "error_count": failure_count,
                "error_percentage": failure_percentage,
                "success": True,
            }

    def length_dqm_check(
        self,
        input_df: DataFrame,
        column_name: str,
        qc_param,
        total_count,
        error_threshold: int,
        qc_filter: str,
        qc_id: int,
        dataset_id: int,
        failure_path: str,
    ) -> dict:
        param_exp = "".join([x for x in qc_param if not x.isdigit()])
        param_value = int("".join([x for x in qc_param if x.isdigit()]))

        if param_exp == ">=":
            length_validation_df = input_df.filter(
                length(col(column_name)).__ge__(param_value)
            )

        elif param_exp == "<=":
            length_validation_df = input_df.filter(
                length(col(column_name)).__le__(param_value),
            )

        elif param_exp == ">":
            length_validation_df = input_df.filter(
                length(col(column_name)).__gt__(param_value),
            )

        elif param_exp == "<":
            length_validation_df = input_df.filter(
                length(col(column_name)).__lt__(param_value),
            )

        elif param_exp == "=":
            length_validation_df = input_df.filter(
                length(col(column_name)).__eq__(param_value),
            )

        elif param_exp == "!=":
            length_validation_df = input_df.filter(
                length(col(column_name)).__ne__(param_value),
            )

        else:
            raise Exception(
                "qc_param is missing. qc_param is required for LENGTH DQM check."
            )

        if qc_filter:
            filter_cols = qc_filter.split(",")
            filter_cols = " AND ".join(filter_cols)
            length_validation_df = length_validation_df.filter(filter_cols)

        failure_count = total_count - length_validation_df.count()

        if failure_count != 0:
            failed_records = input_df.subtract(length_validation_df)
            failed_records = (
                failed_records.withColumn("dqm_check_type", lit("LENGTH"))
                .withColumn("failed_column_name", lit(column_name))
                .withColumn("fail_value", col(column_name))
                .select(
                    "dqm_check_type", "failed_column_name", "fail_value", "batch_id"
                )
            )

            failed_records.write.format("delta").mode("append").partitionBy(
                "batch_id"
            ).save(failure_path)

        if total_count > 0:
            failure_percentage = (failure_count / total_count) * 100
        else:
            failure_percentage = 0

        if failure_percentage >= error_threshold:
            return {
                "df": None,
                "error_count": failure_count,
                "error_percentage": failure_percentage,
                "success": False,
            }
        else:
            return {
                "df": length_validation_df,
                "error_count": failure_count,
                "error_percentage": failure_percentage,
                "success": True,
            }

    def length_range_dqm_check(
        self,
        input_df: DataFrame,
        column_name: str,
        qc_param,
        total_count,
        error_threshold: int,
        qc_filter: str,
        qc_id: int,
        dataset_id: int,
        failure_path: str,
    ) -> dict:
        range_list = literal_eval(qc_param)
        param_value_lower = min(range_list)
        param_value_greater = max(range_list)

        length_range_dqm_df = input_df.filter(
            (length(col(column_name)).__ge__(param_value_lower))
            & (length(col(column_name)).__le__(param_value_greater)),
        )

        if qc_filter:
            filter_cols = qc_filter.split(",")
            filter_cols = " AND ".join(filter_cols)
            length_range_dqm_df = length_range_dqm_df.filter(filter_cols)

        failure_count = total_count - length_range_dqm_df.count()

        if failure_count != 0:
            failed_records = input_df.subtract(length_range_dqm_df)
            failed_records = (
                failed_records.withColumn("dqm_check_type", lit("LENGTH-RANGE"))
                .withColumn("failed_column_name", lit(column_name))
                .withColumn("fail_value", col(column_name))
                .select(
                    "dqm_check_type", "failed_column_name", "fail_value", "batch_id"
                )
            )

            failed_records.write.format("delta").mode("append").partitionBy(
                "batch_id"
            ).save(failure_path)

        if total_count > 0:
            failure_percentage = (failure_count / total_count) * 100
        else:
            failure_percentage = 0
        if failure_percentage >= error_threshold:
            return {
                "df": None,
                "error_count": failure_count,
                "error_percentage": failure_percentage,
                "success": False,
            }
        else:
            return {
                "df": length_range_dqm_df,
                "error_count": failure_count,
                "error_percentage": failure_percentage,
                "success": True,
            }

    def date_dqm_check(
        self,
        input_df: DataFrame,
        column_name: str,
        qc_param,
        total_count,
        error_threshold: int,
        qc_filter: str,
        qc_id: int,
        dataset_id: int,
        failure_path: str,
    ) -> dict:
        date_regex_pattern = RegexDateFormats.get_date_regex(qc_param=qc_param)

        date_dqm_df = input_df.filter(col(column_name).rlike(date_regex_pattern))

        if qc_filter:
