    def custom_dqm_check(
        self,
        input_df: DataFrame,
        qc_param: str,
        qc_id,
        total_count,
        dataset_id: int,
        error_threshold: int,
        failure_path: str,
    ) -> dict:
        input_df.createOrReplaceTempView(f"table_{qc_id}")
        custom_dqm_df = self.spark.sql(qc_param)

        failure_count = total_count - custom_dqm_df.count()

        if failure_count != 0:
            failed_records = input_df.subtract(custom_dqm_df)

            failed_records.write.format("delta").mode("append").partitionBy(
                "batch_id"
            ).save(f"{failure_path}/custom_dqm_failures/")

        if total_count > 0:
            failure_percentage = (failure_count / total_count) * 100
        else:
            failure_percentage = 0

        if failure_percentage >= error_threshold:
            return {
                "df": None,
                "error_count": failure_count,
                "error_percentage": failure_percentage,
                "success": False,
            }
        else:
            return {
                "df": custom_dqm_df,
                "error_count": failure_count,
                "error_percentage": failure_percentage,
                "success": True,
            }

    def unique_dqm_check(
        self,
        input_df: DataFrame,
        column_name: str,
        total_count,
        error_threshold: int,
        qc_filter: str,
        qc_id: int,
        dataset_id: int,
        failure_path: str,
        batch_id: int,
    ) -> dict:

        unique_dqm_df = input_df.dropDuplicates(column_name.split(","))

        if qc_filter:
            filter_cols = qc_filter.split(",")
            filter_cols = " AND ".join(filter_cols)
            unique_dqm_df = unique_dqm_df.filter(filter_cols)

        failure_count = total_count - unique_dqm_df.count()

        if failure_count != 0:
            failed_records = (
                input_df.groupBy(column_name.split(",")).count().filter("count>1")
            ).withColumn("batch_id", lit(batch_id))
            failed_records.show()
            failed_records.write.format("delta").mode("append").partitionBy(
                "batch_id"
            ).save(f"{failure_path}/unique_dqm_failures/")

        if total_count > 0:
            failure_percentage = (failure_count / total_count) * 100
        else:
            failure_percentage = 0

        if failure_percentage >= error_threshold:
            return {
                "df": None,
                "error_count": failure_count,
                "error_percentage": failure_percentage,
                "success": False,
            }
        else:
            return {
                "df": unique_dqm_df,
                "error_count": failure_count,
                "error_percentage": failure_percentage,
                "success": True,
            }

    def blank_dqm_check(
        self,
        input_df: DataFrame,
        qc_id: int,
        dataset_id: int,
        qc_filter: str,
    ) -> dict:
        if qc_filter:
            filter_cols = qc_filter.split(",")
            filter_cols = " AND ".join(filter_cols)

            input_df = input_df.filter(filter_cols)

        if not input_df.isEmpty():
            return {
                "df": input_df,
                "error_count": 0,
                "error_percentage": 0,
                "success": False,
            }
        else:
            return {
                "df": None,
                "error_count": None,
                "error_percentage": 100,
                "success": False,
            }

    def start_dqm_check(self):
        if len(self.dqm_unprocessed_files) != 0:
            for data_standardisation_log in self.dqm_unprocessed_files:
                start_time = datetime.now()
                batch_id = data_standardisation_log.batch_id

                file_df = (
                    self.spark.read.format("delta")
                    .load(self.data_standardisation_location)
                    .filter(col("batch_id") == batch_id)
                )
                original_df = file_df

                for dqm_master in self.dqm_masters:
                    total_count = file_df.count()
                    if dqm_master.qc_type == "Null":
                        response = self.null_check_dqm(
                            input_df=file_df,
                            column_name=dqm_master.column_name,
                            total_count=total_count,
                            error_threshold=dqm_master.criticality_threshold_pct,
                            qc_id=dqm_master.qc_id,
                            dataset_id=self.dataset_id,
                            qc_filter=dqm_master.qc_filter,
                            failure_path=self.dqm_location,
                        )
                        if response["success"] == True:
                            file_df: DataFrame = response["df"]

                            with (
                                OrchestrationProcess.OrchestrationProcess() as orch_process
                            ):
                                orch_process.insert_log_dqm_dtl(
                                    process_id=self.process_id,
                                    dataset_id=self.dataset_id,
                                    batch_id=batch_id,
                                    source_file=data_standardisation_log.source_file,
                                    column_name=dqm_master.column_name,
                                    qc_type=dqm_master.qc_type,
                                    qc_param=dqm_master.qc_param,
                                    qc_filter=dqm_master.qc_filter,
                                    criticality=dqm_master.criticality,
                                    criticality_threshold_pct=dqm_master.criticality_threshold_pct,
                                    error_count=response["error_count"],
                                    error_pct=response["error_percentage"],
                                    status="SUCCEEDED",
                                    dqm_start_time=start_time,
                                    dqm_end_time=datetime.now(),
                                )

                        else:
                            with (
                                OrchestrationProcess.OrchestrationProcess() as orch_process
                            ):
                                orch_process.insert_log_dqm_dtl(
                                    process_id=self.process_id,
                                    dataset_id=self.dataset_id,
                                    batch_id=batch_id,
                                    source_file=data_standardisation_log.source_file,
                                    column_name=dqm_master.column_name,
                                    qc_type=dqm_master.qc_type,
                                    qc_param=dqm_master.qc_param,
                                    qc_filter=dqm_master.qc_filter,
                                    criticality=dqm_master.criticality,
                                    criticality_threshold_pct=dqm_master.criticality_threshold_pct,
                                    error_count=response["error_count"],
                                    error_pct=response["error_percentage"],
                                    status=(
                                        "FAILED"
                                        if dqm_master.criticality == "C"
                                        else "SUCCEEDED"
                                    ),
                                    dqm_start_time=start_time,
                                    dqm_end_time=datetime.now(),
                                )
                            if dqm_master.criticality == "C":

                                raise Exception(
                                    f"Error Threshold exceeds Criticality Threshold for Dataset ID {self.dataset_id} For Column Name: {dqm_master.column_name} For DQM Type {dqm_master.qc_type}"
                                )

                    elif dqm_master.qc_type == "Unique":

                        response = self.unique_dqm_check(
                            input_df=file_df,
                            column_name=dqm_master.column_name,
                            total_count=total_count,
                            error_threshold=dqm_master.criticality_threshold_pct,
                            qc_id=dqm_master.qc_id,
                            dataset_id=self.dataset_id,
                            qc_filter=dqm_master.qc_filter,
                            failure_path=self.dqm_location,
                            batch_id=batch_id,
                        )
                        if response["success"] == True:
                            file_df = response["df"]
                            with (
                                OrchestrationProcess.OrchestrationProcess() as orch_process
                            ):
                                orch_process.insert_log_dqm_dtl(
                                    process_id=self.process_id,
                                    dataset_id=self.dataset_id,
                                    batch_id=batch_id,
                                    source_file=data_standardisation_log.source_file,
                                    status="SUCCEEDED",
                                    dqm_start_time=start_time,
                                    dqm_end_time=datetime.now(),
                                )
                        else:
                            with (
                                OrchestrationProcess.OrchestrationProcess() as orch_process
                            ):
                                orch_process.insert_log_dqm_dtl(
                                    process_id=self.process_id,
                                    dataset_id=self.dataset_id,
                                    batch_id=batch_id,
                                    source_file=data_standardisation_log.source_file,
                                    column_name=dqm_master.column_name,
                                    qc_type=dqm_master.qc_type,
                                    qc_param=dqm_master.qc_param,
                                    qc_filter=dqm_master.qc_filter,
                                    criticality=dqm_master.criticality,
                                    criticality_threshold_pct=dqm_master.criticality_threshold_pct,
                                    error_count=response["error_count"],
                                    error_pct=response["error_percentage"],
                                    status=(
                                        "FAILED"
                                        if dqm_master.criticality == "C"
                                        else "SUCCEEDED"
                                    ),
                                    dqm_start_time=start_time,
                                    dqm_end_time=datetime.now(),
                                )
                            if dqm_master.criticality == "C":
                                raise Exception(
                                    f"Error Threshold exceeds Criticality Threshold for Dataset ID {self.dataset_id} For Column Name: {dqm_master.column_name} For DQM Type {dqm_master.qc_type}"
                                )

                    elif dqm_master.qc_type == "Date":
                        response = self.date_dqm_check(
                            input_df=file_df,
                            column_name=dqm_master.column_name,
                            total_count=total_count,
                            error_threshold=dqm_master.criticality_threshold_pct,
                            qc_id=dqm_master.qc_id,
                            qc_param=dqm_master.qc_param,
                            dataset_id=self.dataset_id,
